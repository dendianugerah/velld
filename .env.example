# Client
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server
JWT_SECRET=your-super-secret-jwt-key-here-use-openssl-rand-hex-32
ENCRYPTION_KEY=your-64-char-hex-key-here-use-openssl-rand-hex-32

# Database (optional; defaults to data/velld.db relative to the API working directory)
# In Docker this is /app/data/velld.db; keep it in a persistent volume.
# DB_PATH=data/velld.db

# Admin credentials (set both for initial setup; existing users can still log in)
ADMIN_USERNAME_CREDENTIAL=your-super-username-admin
ADMIN_PASSWORD_CREDENTIAL=your-super-password-admin

# Email Notifications (optional - configure via UI or environment variables)
# When set via env vars, these fields become read-only in the UI
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# Restore checks (optional; enabled by default)
# PostgreSQL/MySQL/MongoDB checks need the Docker discovery overlay.
# D1 checks use temporary SQLite, without Docker.
# RESTORE_CHECK_ENABLED=false

# PostgreSQL PITR only: mount the WAL archive and use its path inside the API.
# Velld reads <archive-root>/<connection-id>.
# VELLD_PITR_WAL_DIR=/wal